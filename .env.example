# ==============================================
# CHATBOT (raiz do repo) — copie para .env
# ==============================================
# O dashboard usa um .env.local proprio, dentro de dashboard/ (ver o fim deste arquivo).
# A tabela completa de variaveis esta no README, secao "Variaveis de ambiente".

# ==============================================
# SUPABASE — fonte de verdade do sistema
# ==============================================
# https://supabase.com/dashboard -> Project Settings -> API
# Sem estas duas, nenhuma autenticacao resolve e todo usuario do WhatsApp
# recebe "servico temporariamente indisponivel".

SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<sua-service-role-key>

# ==============================================
# GOOGLE SHEETS (legado, unidirecional banco -> planilha)
# ==============================================
# As tres primeiras sao exigidas no boot (o servidor faz exit(1) sem elas), mesmo
# que voce nao va usar Sheets — nesse caso preencha com qualquer valor.
#
# Cuidado: a validacao checa se a VARIAVEL existe, nao se o arquivo de credenciais
# existe. Com o caminho apontando para um credentials.json ausente, o servidor sobe
# e so falha quando tenta falar com o Sheets.

GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
GOOGLE_SHEETS_ENGINEER_ID=<id-da-planilha-do-engenheiro>
GOOGLE_SHEETS_ENGINEER_NAME=Engenheiro(a)
GOOGLE_SHEETS_ENGINEER_RANGE=A1:AE1000

# Planilhas adicionais por engenheiro (opcional; sem _ID a planilha e ignorada).
# _WHATSAPP filtra quais atribuicoes vao para cada planilha.
# GOOGLE_SHEETS_ENG1_ID=
# GOOGLE_SHEETS_ENG1_NAME=
# GOOGLE_SHEETS_ENG1_RANGE=
# GOOGLE_SHEETS_ENG1_WHATSAPP=
# GOOGLE_SHEETS_ENG2_ID=
# GOOGLE_SHEETS_ENG3_ID=

# Planilha consolidada (opcional)
# GOOGLE_SHEETS_CEO_ID=
# GOOGLE_SHEETS_CEO_NAME=Dashboard
# GOOGLE_SHEETS_CEO_RANGE=A2:Z1000

# ==============================================
# PROVIDER DE WHATSAPP
# ==============================================
# development: so imprime no console — use para desenvolver sem Twilio
# twilio:      envio real (o que roda em producao)
# meta:        Meta WhatsApp Business API

WHATSAPP_PROVIDER=development

# Necessarias se WHATSAPP_PROVIDER=twilio (a falta so gera warning no boot)
TWILIO_ACCOUNT_SID=<seu-account-sid>
TWILIO_AUTH_TOKEN=<seu-auth-token>
TWILIO_PHONE_NUMBER=<+14155238886>

# Necessarias se WHATSAPP_PROVIDER=meta
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_API_VERSION=v18.0

# ==============================================
# SERVIDOR
# ==============================================
# Railway define PORT automaticamente.

PORT=3000

# ==============================================
# AGENDAMENTOS
# ==============================================
# Frequencia do sync banco -> Sheets. Default: a cada 5 minutos.
# SYNC_CRON_SCHEDULE=*/5 * * * *

# Limpeza semestral de projetos finalizados. Desligada por padrao; ativa
# somente com a string exata "true".
# ENABLE_PROJECT_CLEANUP_CRON=false

# ==============================================
# OPENAI (opcional)
# ==============================================
# Transcricao de audio via Whisper. So e usada no caminho legado
# (npm run dev:whatsapp-web) — o servidor Twilio de producao ignora midia.

# OPENAI_API_KEY=<sua-chave>

# ==============================================
# DASHBOARD — arquivo separado: dashboard/.env.local
# ==============================================
# NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<sua-anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<sua-service-role-key>
#
# Sem as duas NEXT_PUBLIC_*, o dashboard sobe com dados FALSOS
# (dashboard/lib/mockData.ts) e Realtime desligado.
