{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "chatbot/**/*",
    "integrations/**/*",
    "logic/**/*",
    "tests/*.ts",
    "scripts/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests/manual/**",
    "scripts/extract-xlsx-templates.ts"
  ]
}
